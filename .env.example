APP_NAME="Blessing Auth"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://localhost:8000
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN

LOG_CHANNEL=daily
LOG_LEVEL=info

DB_CONNECTION=sqlite
# 默认使用 database/database.sqlite；如用 MySQL 取消以下注释
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=blessing_auth
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ------- 邮件（SMTP，后台设置优先于这里） -------
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ------- 站点设置 -------
# 是否开放注册
SITE_ALLOW_REGISTER=true
# 注册赠送积分
SITE_INITIAL_SCORE=1000
# 创建一个角色消耗的积分
SITE_PLAYER_COST=100
# 每日签到获得积分
SITE_SIGN_SCORE=50

# ------- Yggdrasil -------
# 令牌有效期（小时），过期后进入暂存期只可 refresh
YGG_TOKEN_VALID_HOURS=72
# 令牌彻底失效期（小时）
YGG_TOKEN_EXPIRE_HOURS=360
# 每用户最大令牌数
YGG_TOKENS_LIMIT=10
# 材质域名白名单（逗号分隔，留空自动使用 APP_URL 域名）
YGG_SKIN_DOMAINS=
